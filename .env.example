PORT=3000

# API Keys (get free keys from these services)
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
WEATHERAPI_KEY=your_weatherapi_key_here

# Feature Flags - toggle providers on/off
ENABLE_OPEN_METEO=true
ENABLE_OPENWEATHER=false
ENABLE_WEATHERAPI=false

# Provider Weights (must sum to ~1.0)
WEIGHT_OPEN_METEO=0.4
WEIGHT_OPENWEATHER=0.3
WEIGHT_WEATHERAPI=0.3
